[
  {
    "ability_id": "ABL-002-01",
    "role_id": "ROLE-002",
    "canonical_name": "Alexander / Kimb / Blockchain",
    "phase": "Triggered",
    "trigger_type": "When one side is about to lose",
    "action_type": "Switch Team",
    "target_type": "Self",
    "usage_limit": "Passive",
    "priority": 90,
    "condition_notes": "When one side is about to lose",
    "effect_notes": "You aren't on anyone's team until one side is about to lose, and then you join that side. You only win if you haven't been eliminated at the end of the game. (She switches teams when a team is about to lose so if the last werewolf dies she becomes a werewolf immediately, or if the werewolves achieve parity she becomes a villager. Basically prolongs the game a little bit longer. And she wins reagardless of her team winning as long as she's alive.\n\nAlso Ted plays that the village doesn't all die the game just ends. It's the only way to make Kimb work properly and Tom Vasel for that matter.)"
  },
